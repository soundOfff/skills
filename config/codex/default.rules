prefix_rule(pattern=["bunx", "@tanstack/intent@latest", "list"], decision="allow")
prefix_rule(pattern=["bunx", "@tanstack/intent@latest", "load", "@tanstack/ai#ai-core/structured-outputs"], decision="allow")
prefix_rule(pattern=["kill", "2833"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "git add src/components/assistant-ui/thread.tsx src/features/assistant/agent-client.test.ts src/features/assistant/agent-client.ts src/features/assistant/agent-protocol.ts src/features/assistant/agent.server.ts src/features/assistant/sessions.api.test.ts src/features/assistant/sessions.api.ts src/features/assistant/sessions.queries.ts src/features/assistant/sessions.schema.ts src/features/assistant/sessions.types.ts src/features/assistant/agent-pack-edit.server.test.ts src/features/jobs/briefing-packs/briefing-pack-actions.test.tsx src/features/jobs/briefing-packs/briefing-pack-actions.tsx src/features/jobs/briefing-packs/briefing-pack-generator.test.ts src/features/jobs/briefing-packs/briefing-pack-page.tsx src/features/jobs/briefing-packs/slide-filmstrip.tsx src/features/jobs/briefing-packs/slide-preview.tsx src/features/jobs/briefing-packs/slide-sheet.tsx src/routes/_studio/jobs.$jobId_.briefing-pack.tsx src/features/jobs/briefing-packs/briefing-pack-assistant-context.tsx src/features/jobs/briefing-packs/briefing-pack-assistant-provider.test.tsx src/features/jobs/briefing-packs/briefing-pack-assistant-provider.tsx src/features/jobs/briefing-packs/pack-edit-agent.server.test.ts src/features/jobs/briefing-packs/pack-edit-agent.server.ts src/features/jobs/briefing-packs/pack-edit-model-output.server.test.ts src/features/jobs/briefing-packs/pack-edit-model-output.server.ts src/features/jobs/briefing-packs/pack-edit-prompt.server.test.ts src/features/jobs/briefing-packs/pack-edit-prompt.server.ts src/features/jobs/briefing-packs/slide-edit-proposal-card.tsx src/features/jobs/briefing-packs/slide-edit-proposal.test.ts src/features/jobs/briefing-packs/slide-edit-proposal.ts src/features/jobs/briefing-packs/slide-reference-chips.tsx"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["bun", "run", "build"], decision="allow")
