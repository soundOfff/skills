{
  "skillListingBudgetFraction": 0.05,
  "permissions": {
    "allow": [
      "mcp__pencil"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "if [ -f '/Users/User/.orca/agent-hooks/claude-statusline.sh' ] && [ -r '/Users/User/.orca/agent-hooks/claude-statusline.sh' ] && [ -x '/Users/User/.orca/agent-hooks/claude-statusline.sh' ]; then /bin/sh '/Users/User/.orca/agent-hooks/claude-statusline.sh'; else cat >/dev/null 2>&1 || :; fi"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": true,
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
